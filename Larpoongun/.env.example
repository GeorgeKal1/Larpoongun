# Copy to .env.local and fill in. .env.local is ignored by git, so secrets stay on your machine.

# Admin area (/admin). Leave empty to keep the admin area locked.
# Pick your own values; anything other than your local machine needs a long random password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Payments: set a Stripe test key to switch from demo payments to Stripe (test mode).
# Get test keys at https://dashboard.stripe.com/test/apikeys — only sk_test_ keys are accepted.
STRIPE_SECRET_KEY=

# Optional: for the webhook, run
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and paste the "whsec_..." secret it prints here.
STRIPE_WEBHOOK_SECRET=

# Optional: where the SQLite database lives (default: data/larpoongun.db)
# DATABASE_PATH=
